# Copy to .env and fill in. With no keys at all, Tripwire runs in SAMPLE_MODE (bundled data, rule-based fallback model).
SAMPLE_MODE=false
PORT=8000

# Zetaris (local Docker platform, http://localhost:3000)
ZETARIS_BASE_URL=http://localhost:3000
# Either username/password (local platform login) or an API key with org id
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
# Where RUN EXPORT writes Parquet inside the Zetaris driver (default /home/zetaris/customer-data/shared/tripwire)
ZETARIS_STORAGE_ROOT=
ZETARIS_TIMEOUT_MS=30000

# Meterless Nightshift: the primary AI provider (OpenAI-compatible runtime on your machine).
# Nightshift > Console shows the URL and the runtime token. Put your NVIDIA key in Nightshift > Setup > Providers, not here.
# LLM_PROVIDER: auto (Nightshift first, NVIDIA direct only as a backup) | nightshift | nvidia
LLM_PROVIDER=auto
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
# Or point at the token file the runtime writes (<stateDir>/proxy-token)
METERLESS_TOKEN_FILE=
METERLESS_APP_ID=tripwire
# Model asked of Nightshift per tier. Defaults are the Nemotron ids below; meterless/deep etc. also work.
METERLESS_REASONING_MODEL=
METERLESS_SMALL_MODEL=
METERLESS_GUARD_MODEL=
METERLESS_TIMEOUT_MS=180000

# Backup only: NVIDIA Nemotron on build.nvidia.com directly (key starts with nvapi-). Used when Nightshift cannot answer.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_REASONING_MODEL=
NVIDIA_SMALL_MODEL=
NVIDIA_GUARD_MODEL=
MODEL_TIMEOUT_MS=60000

# Meterless H-MEM persistence directory (default data/ledger/memory)
HMEM_DIR=

# SEC EDGAR requires a descriptive User-Agent with contact info
SEC_USER_AGENT=

RUN_TIMEOUT_MS=180000
