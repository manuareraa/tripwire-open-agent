{
  "name": "tripwire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agents that make business decisions, record what each depends on, and reopen only the affected ones when data changes.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "prestart": "npm run build:web",
    "start": "tsx server.ts",
    "build": "tsc -p tsconfig.json",
    "build:web": "vite build --config console/vite.config.ts",
    "dev:web": "vite --config console/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p console/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
